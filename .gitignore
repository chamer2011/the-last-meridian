node_modules/
# The installer, which app/build.js makes
dist/
# Your API key and saved games
data/
# Copies of the game from before each big change, which only matter on this computer
backups/
# Claude's own settings for this computer
.claude/settings.local.json

# Art bought for this computer only: its licence forbids giving the files away, so it never goes to GitHub
licensed/

# The Godot view (godot/): what Godot makes for itself there, and the Godot program, which start-godot.bat fetches
godot/.godot/
godot-engine/
