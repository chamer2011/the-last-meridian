     "type": "",
     "gid": 2,
     "x": 336,
     "y": 1120,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "Someone has chalked DON'T on the hatch of the number two duct, and nothing else. If you hold your breath, there's a faint sound behind it."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I put my ear to the number two duct and listen."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "u"
      }
     ]
    },
    {
     "id": 9,
     "name": "Cass",
     "type": "",
     "gid": 1,
     "x": 720,
     "y": 1120,
     "width": 48,
     "height": 96,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "person",
       "type": "string",
       "value": "naomi"
      },
      {
       "name": "asks",
       "type": "string",
       "value": "What's the word in the crawlways?\nWhat'll it cost me to find something out?"
      },
      {
       "name": "mark",
       "type": "string",
       "value": "N"
      }
     ]
    },
    {
     "id": 10,
     "name": "Warm bedrolls",
     "type": "",
     "gid": 2,
     "x": 976,
     "y": 1120,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "Bedrolls wedged into the warm stretch of duct, each one somebody's whole home. It smells of coolant and sleep."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I crouch down by the bedrolls and ask who's sleeping here."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "y"
      }
     ]
    },
    {
     "id": 11,
     "name": "Reactor gauges",
     "type": "",
     "gid": 2,
     "x": 4496,
     "y": 1120,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "Three gauges on the bulkhead. Two of them are taped over, and someone has written FINE on the tape."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I peel back the tape on the reactor gauges and read them."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "g"
      }
     ]
    },
