    {
     "id": 6,
     "name": "Number two duct",
     "type": "",
     "gid": 2,
     "x": 336,
     "y": 1120,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "Someone has chalked DON'T on the hatch of the number two duct, and nothing else. If you hold your breath, there's a faint sound behind it."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I put my ear to the number two duct and listen."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "u"
      }
     ]
    },
    {
     "id": 7,
     "name": "Cass",
     "type": "",
     "gid": 1,
     "x": 720,
     "y": 1120,
     "width": 48,
     "height": 96,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "person",
       "type": "string",
       "value": "naomi"
      },
      {
       "name": "asks",
       "type": "string",
       "value": "What's the word in the crawlways?\nWhat'll it cost me to find something out?"
      },
      {
       "name": "mark",
       "type": "string",
       "value": "N"
      }
     ]
    },
    {
     "id": 8,
     "name": "Warm bedrolls",
     "type": "",
     "gid": 2,
     "x": 976,
     "y": 1120,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "Bedrolls wedged into the warm stretch of duct, each one somebody's whole home. It smells of coolant and sleep."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I crouch down by the bedrolls and ask who's sleeping here."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "y"
      }
     ]
    },
    {
     "id": 9,
     "name": "Reactor gauges",
     "type": "",
     "gid": 2,
     "x": 4496,
     "y": 1120,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "Three gauges on the bulkhead. Two of them are taped over, and someone has written FINE on the tape."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I peel back the tape on the reactor gauges and read them."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "g"
      }
     ]
    },
    {
     "id": 10,
     "name": "Coolant tanks",
     "type": "",
     "gid": 2,
     "x": 2064,
     "y": 1376,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "Big coolant tanks at the back of the aft hold, sweating in the heat. There's a gap behind them, just wide enough to make you wonder."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I go round and look behind the coolant tanks."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "o"
      }
     ]
    },
    {
     "id": 11,
     "name": "The empty hold",
     "type": "",
     "gid": 2,
     "x": 1776,
     "y": 1504,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "The manifest says this hold is empty. There's a lot of tarp in here for an empty hold."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I lift the tarps and see what's actually in the aft hold."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "h"
      }
     ]
    },
    {
     "id": 12,
     "name": "Tool roll on the bench",
