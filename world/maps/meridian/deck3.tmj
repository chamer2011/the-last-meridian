       "type": "string",
       "value": "K"
      }
     ]
    },
    {
     "id": 17,
     "name": "A manifest on a clip",
     "type": "",
     "gid": 2,
     "x": 2128,
     "y": 1696,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "It says this hold has been empty since the refit. It's been signed by someone who's very sure of that, and countersigned by someone who wasn't there."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I read through the manifest and ask who signed it."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "m"
      }
     ]
    },
