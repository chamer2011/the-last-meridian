       "value": "marrow"
      },
      {
       "name": "asks",
       "type": "string",
       "value": "How's the reactor holding up, Chief?\nWhat aren't you telling me about this ship?"
      },
      {
       "name": "mark",
       "type": "string",
       "value": "M"
      }
     ]
    },
