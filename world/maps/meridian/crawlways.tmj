     ]
    },
    {
     "id": 4,
     "name": "Warm bedrolls",
     "type": "",
     "gid": 2,
     "x": 1456,
     "y": 480,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "Bedrolls wedged into the warm stretch of duct, each one somebody's whole home. It smells of coolant and sleep."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I crouch down by the bedrolls and ask who's sleeping here."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "y"
      }
     ]
    },
    {
     "id": 5,
     "name": "Number two duct",
     "type": "",
     "gid": 2,
     "x": 80,
     "y": 544,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "Someone has chalked DON'T on the hatch of the number two duct, and nothing else. If you hold your breath, there's a faint sound behind it."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I put my ear to the number two duct and listen."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "u"
      }
     ]
    },
