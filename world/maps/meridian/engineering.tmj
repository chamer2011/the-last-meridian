  {
   "id": 3,
   "name": "People and things",
   "type": "objectgroup",
   "draworder": "topdown",
   "objects": [
    {
     "id": 1,
     "name": "Capacitor bank",
     "type": "",
     "gid": 2,
     "x": 1520,
     "y": 224,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "The cannon's capacitor bank, patched with three kinds of cable. The sign above it is in Marrow's handwriting, and he means it."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I check over the cannon's capacitor bank with whoever's on shift."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "b"
      }
     ]
    },
    {
     "id": 2,
     "name": "The reactor",
     "type": "",
     "gid": 2,
     "x": 944,
     "y": 352,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "It's loud, it's hot, and it runs on spite and Marrow's swearing. You can feel it in your teeth from here."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I ask for someone to walk me through how the reactor's really doing."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "e"
      }
     ]
    },
    {
     "id": 3,
     "name": "Marrow",
     "type": "",
     "gid": 1,
     "x": 1040,
     "y": 416,
     "width": 48,
     "height": 96,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "person",
       "type": "string",
       "value": "marrow"
      },
      {
       "name": "asks",
       "type": "string",
       "value": "How's the reactor holding up, Chief?\nWhat aren't you telling me about this ship?"
      },
      {
       "name": "mark",
       "type": "string",
       "value": "M"
      }
     ]
    },
    {
     "id": 4,
     "name": "Reactor gauges",
     "type": "",
     "gid": 2,
     "x": 2096,
     "y": 608,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "Three gauges on the bulkhead. Two of them are taped over, and someone has written FINE on the tape."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I peel back the tape on the reactor gauges and read them."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "g"
      }
     ]
    },
    {
     "id": 5,
     "name": "names",
