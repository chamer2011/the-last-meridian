    },
    {
     "id": 2,
     "name": "Calm tabs",
     "type": "",
     "gid": 2,
     "x": 1552,
     "y": 160,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "item",
       "type": "string",
       "value": "calm_tabs"
      },
      {
       "name": "look",
       "type": "string",
       "value": "A dispenser of calm tabs with a handwritten tally taped to it. The tally is longer than you'd like."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I ask the doctor for a strip of calm tabs."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "q"
      }
     ]
    },
    {
     "id": 3,
     "name": "A cot with its curtain drawn",
     "type": "",
     "gid": 2,
     "x": 304,
     "y": 288,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "A shape under a thin blanket, and a hand that doesn't move when you stop beside it. The chart at the foot of the cot has been filled in very neatly."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I read the chart on the curtained cot and ask how they're doing."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "c"
      }
     ]
    },
    {
     "id": 4,
     "name": "The scan bed",
     "type": "",
     "gid": 2,
     "x": 1136,
     "y": 288,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "The medbay's one working scanner. Its log has a lot of entries at three in the morning."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I ask the doctor to run me through the scan bed."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "b"
      }
     ]
    },
    {
     "id": 5,
     "name": "Aduro",
     "type": "",
     "gid": 1,
     "x": 816,
     "y": 416,
     "width": 48,
     "height": 96,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "person",
       "type": "string",
       "value": "aduro"
      },
      {
       "name": "asks",
       "type": "string",
       "value": "How bad is it in here, Doctor?\nWhat's the medbay short of?"
      },
      {
       "name": "mark",
       "type": "string",
       "value": "A"
      }
     ]
    },
    {
     "id": 6,
     "name": "Emergency hull patches",
     "type": "",
     "gid": 2,
     "x": 1552,
     "y": 416,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "item",
       "type": "string",
       "value": "emergency_patch"
      },
      {
       "name": "look",
       "type": "string",
       "value": "A rack of emergency hull patches, stored in the medbay because it's the one locker with a working seal."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I ask the doctor if I can take one of the emergency hull patches."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "p"
      }
     ]
    },
    {
     "id": 7,
     "name": "Start",
     "type": "",
     "gid": 4,
     "x": 816,
     "y": 544,
     "width": 40,
     "height": 64,
     "rotation": 0,
     "visible": true
    },
    {
     "id": 8,
     "name": "The queue",
     "type": "",
     "gid": 2,
     "x": 816,
     "y": 672,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "A bench for six, with eleven people on it. Nobody's complaining, which worries you more than if they were."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I sit down on the bench with the queue and ask what brought them here."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "w"
      }
     ]
    }
