    },
    {
     "id": 7,
     "name": "Hot-bunk slate",
     "type": "",
     "gid": 2,
     "x": 432,
     "y": 224,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "Bunk hours, traded and re-traded in a dozen hands. Nine hundred people on a ship built for three hundred, and a hot bunk is worth more than money."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I read the hot-bunk slate and ask who's going without."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "s"
      }
     ]
    },
    {
     "id": 8,
     "name": "Roe",
     "type": "",
     "gid": 1,
     "x": 1552,
     "y": 224,
     "width": 48,
     "height": 96,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "person",
       "type": "string",
       "value": "bastian"
      },
      {
       "name": "asks",
       "type": "string",
       "value": "How are people holding up, Father?\nWho are you here for today?"
      },
      {
       "name": "mark",
       "type": "string",
       "value": "R"
      }
     ]
    },
    {
     "id": 9,
     "name": "medbay",
     "type": "",
     "gid": 3,
     "x": 208,
     "y": 288,
     "width": 40,
     "height": 64,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "to",
       "type": "string",
       "value": "medbay"
      },
      {
       "name": "via",
       "type": "string",
       "value": "1"
      },
      {
       "name": "mark",
       "type": "string",
       "value": "5"
      }
     ]
    },
    {
     "id": 10,
     "name": "The chalked names",
     "type": "",
     "gid": 2,
     "x": 1008,
     "y": 288,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "Names in chalk from the deck to the overhead, in dozens of different hands. Nobody ordered it, and nobody dares wash it."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I stop at the Names Bulkhead and read the names, taking my time."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "n"
      }
     ]
    },
    {
     "id": 11,
     "name": "Stub of chalk",
     "type": "",
     "gid": 2,
     "x": 1456,
     "y": 288,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "A stub of chalk on a pipe bracket, worn down to a thumbnail. Someone will need it tomorrow."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I take the chalk and add a name I've been carrying."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "w"
      }
     ]
    },
    {
     "id": 12,
     "name": "Old Concord medal",
     "type": "",
     "gid": 2,
     "x": 1712,
     "y": 288,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "item",
       "type": "string",
       "value": "old_concord_medal"
      },
      {
       "name": "look",
       "type": "string",
       "value": "A Concord service medal, hung from a pipe under one of the names. Its ribbon has gone grey."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I take down the old Concord medal and ask who it belongs to."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "m"
      }
     ]
    },
    {
