    {
     "id": 13,
     "name": "Ready room locker",
     "type": "",
     "gid": 2,
     "x": 1776,
     "y": 864,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "The old captain's locker, just inside the ready room, with a private seal still on it. Nobody's opened it since the Fall, or nobody's admitted to it."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I go into the ready room and try the old captain's sealed locker."
      },
      {
       "name": "used",
       "type": "string",
       "value": "The seal holds. It's the old captain's, and nobody has the code, or nobody's admitting to it. Marrow could cut it. You'd have to decide to ask him."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "l"
      }
     ]
    },
