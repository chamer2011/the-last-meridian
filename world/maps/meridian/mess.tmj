  {
   "id": 3,
   "name": "People and things",
   "type": "objectgroup",
   "draworder": "topdown",
   "objects": [
    {
     "id": 1,
     "name": "Sitting rota",
     "type": "",
     "gid": 2,
     "x": 976,
     "y": 32,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "Four sittings, nine hundred people, one hall. The rota's been rewritten so many times that the paper has gone soft."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I read through the sitting rota and ask who's been going hungry."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "s"
      }
     ]
    },
    {
     "id": 2,
     "name": "Soup kettle",
     "type": "",
     "gid": 2,
     "x": 336,
     "y": 160,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "Today's soup is mostly hot water and good intentions. Someone has chalked a name on the side of the kettle."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I take a bowl of today's soup and sit with whoever's eating."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "k"
      }
     ]
    },
    {
     "id": 3,
     "name": "A wobbling table",
     "type": "",
     "gid": 2,
     "x": 1328,
     "y": 224,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "Every table in the hall wobbles but one. Someone has folded ration slips under the legs of this one, and someone else keeps taking them."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I sit down at the wobbling table with whoever's there, and ask how they're doing."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "w"
      }
     ]
    },
    {
     "id": 4,
     "name": "Halm",
     "type": "",
     "gid": 1,
     "x": 2032,
     "y": 288,
     "width": 48,
     "height": 96,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "person",
       "type": "string",
       "value": "halm"
      },
      {
       "name": "asks",
       "type": "string",
       "value": "What does the council want, Speaker?\nHow are the civilians taking all this?"
      },
      {
       "name": "mark",
       "type": "string",
       "value": "H"
      }
     ]
    },
    {
     "id": 5,
     "name": "Seven",
     "type": "",
     "gid": 1,
     "x": 1040,
     "y": 416,
     "width": 48,
     "height": 96,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "person",
       "type": "string",
       "value": "seven"
      },
      {
       "name": "asks",
       "type": "string",
       "value": "How are the synthetics being treated aboard?\nWhat do you need from me?"
      },
      {
       "name": "mark",
       "type": "string",
       "value": "S"
      }
     ]
    },
    {
     "id": 6,
     "name": "The far table",
     "type": "",
     "gid": 2,
     "x": 1968,
     "y": 416,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "The one table in the hall that doesn't wobble, which is why the council meets here. The carved initials go back three captains."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I sit down at the far table and make it clear that I've got time to listen."
      },
      {
       "name": "useOther",
       "type": "string",
       "value": "I sit down near the far table, and listen to what's being said there."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "f"
      }
     ]
    },
    {
     "id": 7,
     "name": "Ration crate",
     "type": "",
     "gid": 2,
     "x": 144,
     "y": 544,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "item",
       "type": "string",
       "value": "ration_pack"
      },
      {
       "name": "look",
       "type": "string",
       "value": "Sealed ration packs, counted twice a day. The quartermaster knows exactly how many are in there, and you're not sure anyone else does."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I ask for a ration pack from the crate, the same as anyone else."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "x"
      }
     ]
    },
    {
     "id": 8,
     "name": "Brandt",
     "type": "",
     "gid": 1,
     "x": 272,
     "y": 608,
     "width": 48,
     "height": 96,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "person",
       "type": "string",
       "value": "odessa"
      },
      {
       "name": "asks",
       "type": "string",
       "value": "How long will the rations really last?\nWhat are we running short of that nobody's said?"
      },
      {
       "name": "mark",
       "type": "string",
       "value": "O"
      }
     ]
    },
    {
