    {
     "id": 3,
     "name": "Coolant tanks",
     "type": "",
     "gid": 2,
     "x": 1776,
     "y": 160,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "Big coolant tanks at the back of the aft hold, sweating in the heat. There's a gap behind them, just wide enough to make you wonder."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I go round and look behind the coolant tanks."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "o"
      }
     ]
    },
    {
     "id": 4,
     "name": "Tarrow",
     "type": "",
     "gid": 1,
     "x": 1296,
     "y": 352,
     "width": 48,
     "height": 96,
     "rotation": 0,
     "visible": true,
     "properties": [
