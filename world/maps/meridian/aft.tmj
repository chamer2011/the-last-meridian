       "name": "person",
       "type": "string",
       "value": "tarrow"
      },
      {
       "name": "asks",
       "type": "string",
       "value": "What's your team looking for down here, Lieutenant?\nIs the ship secure?"
      },
      {
       "name": "mark",
       "type": "string",
       "value": "K"
      }
     ]
    },
    {
     "id": 5,
     "name": "The empty hold",
     "type": "",
     "gid": 2,
     "x": 1008,
     "y": 416,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "The manifest says this hold is empty. There's a lot of tarp in here for an empty hold."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I lift the tarps and see what's actually in the aft hold."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "h"
