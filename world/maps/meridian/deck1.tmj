     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "item",
       "type": "string",
       "value": "data_chip"
      },
      {
       "name": "look",
       "type": "string",
       "value": "An unlabeled, encrypted data chip, left in the comms tray. Someone would pay to read it, or pay more to destroy it."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I pick up the unlabeled data chip from the comms tray and ask whose it is."
      },
      {
       "name": "used",
       "type": "string",
       "value": "Nobody on the bridge will say whose it is. Sorel looks at his board. Vey's arm goes faintly green."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "d"
      }
     ]
    },
    {
     "id": 2,
     "name": "Sorel",
     "type": "",
     "gid": 1,
     "x": 720,
     "y": 416,
