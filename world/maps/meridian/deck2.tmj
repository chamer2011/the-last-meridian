    },
    {
     "id": 49,
     "name": "The Hot Bunks",
     "type": "Room",
     "x": 2304,
     "y": 1216,
     "width": 1056,
     "height": 704,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "id",
       "type": "string",
       "value": "bunks"
      },
      {
       "name": "aliases",
       "type": "string",
       "value": "hot bunks\nbunks\nthe racks\ncrew quarters\nquarters"
      },
      {
       "name": "desc",
       "type": "string",
       "value": "Built for a third of the people who sleep here, so every rack is shared by shifts, and a bunk is never cold. The few cabins at the far end have doors, which makes them the most envied rooms on the ship."
      }
     ]
    },
