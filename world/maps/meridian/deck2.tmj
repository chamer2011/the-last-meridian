     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "Shelves behind a wire door, and the smell of whatever's nearest to going off."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "n"
      }
     ]
    },
    {
     "id": 5,
     "name": "Medicine cabinet",
     "type": "",
     "gid": 2,
     "x": 1104,
     "y": 224,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "A locked cabinet with a list on its door of what's left."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "m"
      }
     ]
    },
    {
     "id": 6,
     "name": "Soup kettle",
     "type": "",
     "gid": 2,
     "x": 1488,
     "y": 224,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "Today's soup is mostly hot water and good intentions. Someone has chalked a name on the side of the kettle."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I take a bowl of today's soup and sit with whoever's eating."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "k"
      }
     ]
    },
    {
     "id": 7,
     "name": "Up to deck 1",
     "type": "",
