    },
    {
     "id": 52,
     "name": "The Hot Bunks",
     "type": "Room",
     "x": 2304,
     "y": 1216,
     "width": 1056,
     "height": 704,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "id",
