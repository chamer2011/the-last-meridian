      },
      {
       "name": "desc",
       "type": "string",
       "value": "Where nine hundred meals a day come from, and the arguments about them."
      }
     ]
    },
    {
     "id": 45,
     "name": "The Garden",
     "type": "Room",
     "x": 2944,
     "y": 128,
     "width": 864,
     "height": 704,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "id",
       "type": "string",
       "value": "garden"
      },
      {
       "name": "desc",
       "type": "string",
       "value": "Trays of greens under lamps, and the smell of wet soil, which is the smell of home for some."
      }
     ]
    },
    {
     "id": 46,
     "name": "The Port Airlock",
     "type": "Room",
     "x": 1376,
