   "objects": [
    {
     "id": 1,
     "name": "The queue",
     "type": "",
     "gid": 2,
     "x": 464,
     "y": 160,
     "width": 40,
     "height": 56,
     "rotation": 0,
     "visible": true,
     "properties": [
      {
       "name": "look",
       "type": "string",
       "value": "A bench for six, with eleven people on it. Nobody's complaining, which worries you more than if they were."
      },
      {
       "name": "use",
       "type": "string",
       "value": "I sit down on the bench with the queue and ask what brought them here."
      },
      {
       "name": "mark",
       "type": "string",
       "value": "w"
      }
     ]
    },
    {
     "id": 2,
     "name": "Sitting rota",
     "type": "",
